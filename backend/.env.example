NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
DATABASE_PATH=./data/launch-platform.sqlite
UPLOAD_DIR=./storage/uploads
# Production only: leave false until the release is deliberately write-enabled.
ENABLE_PRODUCTION_WRITES=false
MAIL_DIR=./.local-mail
SESSION_SECRET=replace-with-at-least-32-random-bytes
ANALYTICS_SALT=replace-with-a-different-random-secret
COOKIE_NAME=launch_session
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Launch Platform <no-reply@example.com>
# TRUST_PROXY=0
